<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Afto</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>soli.Cloude</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cloude</string>
				<string>afto</string>
			</array>
		</dict>
	</array>
<key>NSMicrophoneUsageDescription</key>
	<string>Afto uses the microphone for voice-to-text input</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Afto transcribes voice input on your device so you can send instructions to your agents.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Afto needs photo access to attach screenshots to your conversations</string>
	<key>NSCameraUsageDescription</key>
	<string>Afto uses the camera to scan the pairing QR for your computer or server</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Afto connects to your agent daemon on a Mac or Linux server</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
</dict>
</plist>
